// Esquema de datos de listaBababueta.
// Ver CLAUDE.md secciones 3 y 5 para el porqué de cada decisión.

generator client {
  // Prisma 7: el generator `prisma-client` sustituye al antiguo
  // `prisma-client-js` (deprecado) y exige una ruta de salida explícita.
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // Prisma 7 ya no admite `url` ni `directUrl` aquí: la conexión de las
  // migraciones vive en prisma.config.ts y la de runtime en el driver
  // adapter que se le pasa a PrismaClient (ver lib/db.ts).
  provider = "postgresql"
}

/// Una lista de regalos. No hay tabla de usuarios: las listas pertenecen
/// implícitamente a la cuenta familiar definida en variables de entorno.
model List {
  id        String   @id @default(cuid())
  title     String
  /// Parte visible de la URL pública: /lista/<slug>
  slug      String   @unique
  /// Clave de acceso en TEXTO PLANO, a propósito (CLAUDE.md §5): los padres
  /// necesitan volver a leerla para compartirla. Único requisito: no vacía.
  /// Se protege con rate limiting en el endpoint de acceso, no con hash.
  accessKey String   @map("access_key")
  /// Dónde enviar los regalos, para quien compra en una tienda online. Texto
  /// LIBRE y opcional, no un formulario de dirección: así los padres deciden
  /// cuánto cuentan — la dirección entera o un "escríbenos y te la pasamos".
  /// Solo sale tras la clave de la lista; nunca en el índice público.
  shippingAddress String? @map("shipping_address")
  /// Orden en el panel y en el índice público, el que dejan los padres
  /// arrastrando las tarjetas. Ordena de menor a mayor.
  ///
  /// NO es un número de fila: los huecos y los negativos están permitidos a
  /// propósito. Una lista nueva entra en (mínimo - 1) para quedarse arriba,
  /// que es donde se mira, sin tener que reescribir la fila de todas las demás
  /// solo para hacerle sitio. Quien lea esto ordenando, que no cuente huecos.
  position  Int      @default(0)
  /// Oculta a la familia. Ojo con el alcance: no es "no listada", es invisible
  /// del todo. La lista desaparece de /listas Y de /lista/<slug>, que responde
  /// "esa lista no existe" aunque quien llame tenga el enlace y haya acertado
  /// la clave (ver lib/lists/queries.ts). Los padres la siguen viendo entera
  /// desde el panel: sirve para archivar los Reyes del año pasado sin perder
  /// quién compró qué.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("lists")
}

/// Estado de un producto. El paso a COMPRADO es la única operación del
/// proyecto con concurrencia real (CLAUDE.md §5).
enum ProductStatus {
  DISPONIBLE
  COMPRADO

  @@map("product_status")
}

model Product {
  id     String @id @default(cuid())
  listId String @map("list_id")
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  title String
  /// Enlace a la tienda. Opcional.
  url   String?
  /// Precio estimado en CÉNTIMOS, como entero: evita los errores de coma
  /// flotante y no obliga a arrastrar el tipo Decimal de Prisma.
  priceCents Int? @map("price_cents")
  comment    String?
  /// URL de una imagen externa. No hay subida de ficheros (CLAUDE.md §3).
  imageUrl   String? @map("image_url")

  /// Orden dentro de SU lista (ver el mismo campo en List). Aquí el regalo
  /// nuevo entra en (máximo + 1), al final: los regalos se van apuntando según
  /// se le ocurren a uno, y ese orden ya es el bueno mientras no se toque.
  position Int @default(0)

  status ProductStatus @default(DISPONIBLE)
  /// Texto libre. Nulo o vacío = compra anónima.
  purchasedBy String?   @map("purchased_by")
  purchasedAt DateTime? @map("purchased_at")

  // --- Soft lock de visualización (CLAUDE.md §3 y §5) ----------------------
  // TODO: columnas creadas pero SIN USAR todavía. Falta el endpoint de latido
  // y el polling desde la UI; se monta cuando haya pantallas con las que ver
  // si el aviso ayuda o estorba.
  //
  // Aviso cosmético de "alguien lo está mirando", alimentado por polling.
  // NO es la garantía de no-doble-compra: esa vive en la actualización
  // condicional del estado. Expira sola a los pocos minutos, por eso se
  // guarda el instante y se compara al leer en vez de limpiarlo con un cron.
  viewerId    String?   @map("viewer_id")
  viewingFrom DateTime? @map("viewing_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // La vista pública siempre filtra por lista y ordena por posición. El índice
  // compuesto sirve para las dos cosas y también para un filtro por listId a
  // secas, así que sustituye al de solo listId en vez de sumarse a él.
  @@index([listId, position])
  @@map("products")
}
