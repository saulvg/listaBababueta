# Plantilla de variables de entorno. Sin valores reales: este fichero SÍ se
# versiona. Cópialo a .env.local y rellénalo; .env.local nunca se commitea.
# Prisma también lee .env.local (ver prisma.config.ts), no solo Next.js.

# --- Base de datos (Neon) ---------------------------------------------------
# DATABASE_URL: cadena CON pooling (el host lleva "-pooler"). La usa la app en
#               runtime, a través del driver adapter de lib/db.ts.
# DIRECT_URL:   cadena DIRECTA, sin pooling. La usa Prisma para migrar, porque
#               pgbouncer no admite las sentencias que necesita Migrate.
#               Ver prisma.config.ts.
# TEST_DATABASE_URL: cadena DIRECTA de la rama `test` de Neon. Los tests de
#                    concurrencia la machacan (crean y borran filas), así que
#                    nunca debe apuntar a la base real.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=

# --- Sesión de los padres (iron-session) ------------------------------------
# Secreto de firma de la cookie. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 32
SESSION_SECRET=

# --- Cuentas de los padres --------------------------------------------------
# No hay tabla de usuarios ni registro abierto (CLAUDE.md §3 y §5): las dos
# cuentas viven aquí. Solo se guarda el hash bcrypt, nunca la contraseña.
PARENT_1_EMAIL=
PARENT_1_PASSWORD_HASH=
PARENT_2_EMAIL=
PARENT_2_PASSWORD_HASH=

# --- Email (Resend) ---------------------------------------------------------
# RESEND_API_KEY: clave de API de Resend.
# EMAIL_FROM:     remitente verificado en Resend (p. ej. avisos@tudominio.com).
# El aviso de "producto comprado" se envía a PARENT_1_EMAIL y PARENT_2_EMAIL.
RESEND_API_KEY=
EMAIL_FROM=

# --- App --------------------------------------------------------------------
# URL pública, para construir los enlaces que se comparten con los familiares.
NEXT_PUBLIC_APP_URL=http://localhost:3000
