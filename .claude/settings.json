{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)"
    ],
    "ask": ["Bash(rm:*)", "Bash(git push:*)"]
  }
}
