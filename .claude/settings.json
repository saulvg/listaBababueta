{
  "permissions": {
    "allow": [
      "Bash(pnpm format *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format:check)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(git commit:*)"
    ],
    "ask": ["Bash(rm:*)", "Bash(git push:*)"]
  }
}
